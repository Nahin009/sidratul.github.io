<script>
  const button = document.querySelector("#mobile-menu-button");
  const menu = document.querySelector("#mobile-menu");

  // Mobile menu
  button?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");

    menu?.classList.toggle("hidden");
    button?.setAttribute("aria-expanded", String(!isOpen));
  });

  // Close mobile menu after selecting a section
  menu?.querySelectorAll("a[data-nav-link]").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      button?.setAttribute("aria-expanded", "false");
    });
  });

  // Highlight the section currently visible on screen
  const sections = document.querySelectorAll("main section[id]");
  const navLinks = document.querySelectorAll("a[data-nav-link]");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const currentId = entry.target.getAttribute("id");

        navLinks.forEach((link) => {
          const href = link.getAttribute("href");

          if (href === `#${currentId}`) {
            link.classList.add("font-medium", "text-zinc-950");
            link.classList.remove("text-zinc-500", "text-zinc-600");
          } else {
            link.classList.remove("font-medium", "text-zinc-950");
            link.classList.add("text-zinc-500");
          }
        });
      });
    },
    {
      rootMargin: "-35% 0px -55% 0px",
    }
  );

  sections.forEach((section) => observer.observe(section));

  // Track section views in Google Analytics
  const trackedSections = document.querySelectorAll("main section[id]");
  const viewedSections = new Set<string>();

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const section = entry.target.getAttribute("id");

        if (!section || viewedSections.has(section)) return;

        viewedSections.add(section);

        const gtag = (window as any).gtag;

        if (typeof gtag === "function") {
          gtag("event", "section_view", {
            section: section,
          });
        }
      });
    },
    {
      threshold: 0.5,
    }
  );

  trackedSections.forEach((section) => sectionObserver.observe(section));
</script>