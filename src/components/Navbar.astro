      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="rounded-md px-3 py-2 text-sm text-zinc-600 transition hover:bg-zinc-100 md:hidden"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >
        Menu
      </button>

    </div>


    <!-- Mobile navigation -->
    <div
      id="mobile-menu"
      class="hidden border-t border-zinc-200 py-4 md:hidden"
    >

      <div class="flex flex-col gap-1 text-sm">

        <a
          href="#about"
          data-nav-link
          class="rounded-md px-3 py-2 text-zinc-600 hover:bg-zinc-100"
        >
